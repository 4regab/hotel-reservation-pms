        <mxCell id="e_pub_booking" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;endSize=10;endFill=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;labelBackgroundColor=#FFFFFF;strokeColor=#E8920C;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.1588235294117647;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="booking" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sub_booking" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;endSize=10;endFill=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;labelBackgroundColor=#FFFFFF;strokeColor=#E8920C;dashed=1;dashPattern=6 4;exitX=0.23823529411764705;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bus" target="booking"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_pub_roomops" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;endSize=10;endFill=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;labelBackgroundColor=#FFFFFF;strokeColor=#E8920C;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.5264705882352941;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="roomops" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sub_roomops" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;endSize=10;endFill=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;labelBackgroundColor=#FFFFFF;strokeColor=#E8920C;dashed=1;dashPattern=6 4;exitX=0.6058823529411764;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bus" target="roomops"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_pub_billing" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;endSize=10;endFill=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;labelBackgroundColor=#FFFFFF;strokeColor=#E8920C;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.8941176470588236;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="billing" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sub_billing" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;endSize=10;endFill=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;labelBackgroundColor=#FFFFFF;strokeColor=#E8920C;dashed=1;dashPattern=6 4;exitX=0.9735294117647059;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bus" target="billing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sub_portal" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;endSize=10;endFill=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;labelBackgroundColor=#FFFFFF;strokeColor=#E8920C;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bus" target="portal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="events_card" value="&lt;b&gt;Events&lt;/b&gt; (a service saves the event in the same transaction as its change; a job delivers it)&lt;br&gt;&lt;br&gt;Booking publishes ReservationConfirmed, ReservationCancelled and ReservationNoShow (to Room Ops, Portal) and RefundRequested (to Billing).&lt;br&gt;Billing publishes PaymentCaptured and RefundCompleted (to Booking, Portal).&lt;br&gt;Room Ops publishes StayCheckedIn and StayCheckedOut (to Booking, Billing, Portal) and MaintenanceBlockApproved (to Portal)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#BDBDBD;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="960" height="150" as="geometry"/></mxCell>
        <mxCell id="legend_card" value='&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color="#3B82F6"&gt;&lt;b&gt;Blue&lt;/b&gt;&lt;/font&gt;: HTTP calls. Portal calls all three services, Room Ops calls Booking and Billing, Billing calls Booking.&lt;br&gt;&lt;font color="#E8920C"&gt;&lt;b&gt;Orange&lt;/b&gt;&lt;/font&gt;: events. Solid goes to the bus, dashed is delivered to each subscriber.&lt;br&gt;&lt;b&gt;Grey&lt;/b&gt;: browsers, databases and outside services. Dashed boxes are outside the system.&lt;br&gt;Services share only the code in src/shared. Locally the Portal and Billing run twice (ports 8104 and 8105) so payment call-backs never wait on themselves.' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#BDBDBD;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1030" y="970" width="700" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
