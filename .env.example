# Copy to .env and change every value that says change-me. Nothing in this file is a real secret.
# Make long random values with:  openssl rand -hex 24

# ---- SQL Server. One server, four databases, one limited login per database.
# sa password: SQL Server requires at least 8 characters with three of: upper case, lower case, digits, symbols.
MSSQL_SA_PASSWORD=Change-me-database-admin-1
BOOKING_DB_PASS=change-me-booking-db-password
ROOMOPS_DB_PASS=change-me-roomops-db-password
BILLING_DB_PASS=change-me-billing-db-password
PORTAL_DB_PASS=change-me-portal-db-password
# Optional: BOOKING_DB_NAME / BOOKING_DB_USER and the same for ROOMOPS, BILLING, PORTAL (defaults: booking_db / booking_app ...)

# ---- Service-to-service secrets. One per caller -> callee pair. Each is given only to those two services.
TOKEN_PORTAL_TO_BOOKING=change-me-portal-to-booking
TOKEN_PORTAL_TO_ROOMOPS=change-me-portal-to-roomops
TOKEN_PORTAL_TO_BILLING=change-me-portal-to-billing
TOKEN_BOOKING_TO_PORTAL=change-me-booking-to-portal
TOKEN_BOOKING_TO_ROOMOPS=change-me-booking-to-roomops
TOKEN_BOOKING_TO_BILLING=change-me-booking-to-billing
TOKEN_ROOMOPS_TO_PORTAL=change-me-roomops-to-portal
TOKEN_ROOMOPS_TO_BOOKING=change-me-roomops-to-booking
TOKEN_ROOMOPS_TO_BILLING=change-me-roomops-to-billing
TOKEN_BILLING_TO_PORTAL=change-me-billing-to-portal
TOKEN_BILLING_TO_BOOKING=change-me-billing-to-booking
TOKEN_BILLING_TO_ROOMOPS=change-me-billing-to-roomops

# ---- Booking: signs price quotes
QUOTE_SECRET=change-me-quote-signing-secret

# ---- Public address and port of the site
PUBLIC_BASE_URL=http://localhost:8080
HTTP_PORT=8080
# Set to 1 when the site is served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=0

# ---- Payments (PayMongo)
# mock    = works offline; a demo page stands in for the hosted checkout page (no real money)
# sandbox = PayMongo test mode. Needs the key and the webhook signing secret from your PayMongo dashboard.
PAYMONGO_MODE=mock
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=change-me-webhook-signing-secret

# ---- Email (Resend). Leave RESEND_API_KEY empty to only log emails (see System health in the staff area).
RESEND_API_KEY=
MAIL_FROM=HarborLight Hotels <reservations@your-domain.example>

# ---- First sign-in. The migrate job creates this IT / privacy lead if no IT account exists.
# Leave the password and the authenticator secret empty to have them generated and printed once in the migrate log:
#   docker compose logs migrate
ADMIN_EMAIL=admin@your-domain.example
ADMIN_NAME=Site administrator
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# ---- Demo data. 1 loads about 135 days of invented bookings and demo accounts for every role. Use 0 for a real hotel.
# Demo accounts all share DEMO_PASSWORD and DEMO_TOTP_SECRET. DEMO USE ONLY: never reuse these anywhere real.
SEED_DEMO=1
DEMO_PASSWORD=harborlight-demo
DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXP
