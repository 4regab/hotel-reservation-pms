# Copy to .env and change the values. Nothing here is a real secret.
# docker compose also works without a .env file: it falls back to the same demo defaults.

# --- MySQL (one server, four databases, one limited user each)
MYSQL_ROOT_PASSWORD=change-me-root
BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking_app
BOOKING_DB_PASS=change-me-booking
ROOMOPS_DB_NAME=roomops_db
ROOMOPS_DB_USER=roomops_app
ROOMOPS_DB_PASS=change-me-roomops
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_app
BILLING_DB_PASS=change-me-billing
PORTAL_DB_NAME=portal_db
PORTAL_DB_USER=portal_app
PORTAL_DB_PASS=change-me-portal

# --- Service-to-service credentials (one per calling service)
TOKEN_PORTAL=change-me-portal-credential
TOKEN_BOOKING=change-me-booking-credential
TOKEN_ROOMOPS=change-me-roomops-credential
TOKEN_BILLING=change-me-billing-credential

# --- Booking: signs price quotes
QUOTE_SECRET=change-me-quote-signing-secret

# --- PayMongo
# mock    = runs fully offline; a demo page stands in for the hosted checkout page
# sandbox = real PayMongo test mode (needs the three values below)
PAYMONGO_MODE=mock
# Your PayMongo sandbox secret key (test keys look like sk_test_<random>). Mock mode ignores it.
PAYMONGO_SECRET_KEY=your-paymongo-sandbox-secret-key
# Signing secret of the webhook you create in the PayMongo dashboard. In mock mode any string works.
PAYMONGO_WEBHOOK_SECRET=your-paymongo-webhook-signing-secret
# Public address of the portal. In sandbox mode PayMongo must reach <this>/v1/webhooks/paymongo (use a tunnel when testing locally).
PUBLIC_BASE_URL=http://localhost:8080

# --- Portal demo accounts (created on start; demo use only)
DEMO_PASSWORD=change-me-demo-password
# Base32 secret for the staff 6-digit code; add it to an authenticator app.
DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXP
# Set to 1 when the portal is served over HTTPS
COOKIE_SECURE=0
